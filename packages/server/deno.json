{
  "name": "@casys/mcp-server",
  "version": "0.27.2",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "include": ["mod.ts", "README.md", "LICENSE"],
    "exclude": ["**/*_test.ts"]
  },
  "tasks": {
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test": "deno test --allow-read mod_test.ts",
    "check": "deno check mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "changelog:draft": "git -C ../.. cliff --config cliff.toml --tag-pattern 'server-v.*' --include-path 'packages/server/**' --unreleased",
    "release:check": "deno task check && deno task lint && deno task test && deno task publish:check",
    "release:tag": "deno run -A ../../scripts/release-tag.ts server"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "exclude": ["dist-node"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@casys/mcp-platform": "jsr:@casys/mcp-platform@^0.28.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  }
}
